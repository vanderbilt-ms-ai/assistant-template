.DS_Store

# Machine-local Claude Code settings (never commit)
.claude/settings.local.json

# Writing samples are the principal's own correspondence. They are read during
# /setup to derive voice.md and they never leave this machine.
writing-samples/*
!writing-samples/README.md
!writing-samples/.gitkeep

# Setup answers contain personal details gathered during the interview.
.claude/setup/answers.md

# Working files: drafts, briefs, notes, research. Delete these three lines if you
# want your assistant's output version controlled.
drafts/
notes/
research/

# Knowledge graph. kb/build/ is derived from the pages and rebuilt by `kb/kb build`.
kb/build/
# kb/wiki/ holds what the assistant learns about you and the people you work with. It
# starts as a copy of kb/seed/ on the first `kb/kb` run. Delete this line if your repo is
# private and you want the graph version controlled (recommended once it is private).
kb/wiki/
